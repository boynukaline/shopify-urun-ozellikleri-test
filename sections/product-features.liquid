{%- comment -%}
  1. Veriyi çekiyoruz. 
  2. Eğer veri boşsa (Metafield Boşsa gereksinimi), Liquid hiçbir şey render etmez.
{%- endcomment -%}

{%- assign features_value = product.metafields.custom.features.value -%}

{%- if features_value != blank -%}
  <section 
    class="product-features" 
    style="
      background-color: {{ section.settings.bg_color }}; 
      padding-top: {{ section.settings.padding_top }}px; 
      padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="page-width">
      {%- if section.settings.title != blank -%}
        <h2>{{ section.settings.title }}</h2>
      {%- endif -%}

      <ul>
        {%- comment -%} Satırları newline (yeni satır) karakterine göre bölüyoruz {%- endcomment -%}
        {%- assign lines = features_value | newline_to_br | split: '<br />' -%}
        
        {%- for line in lines -%}
          {%- assign clean_item = line | strip | strip_newlines -%}
          {%- if clean_item != blank -%}
            <li>{{ clean_item }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Ürün Özellikleri",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "Ürün Özellikleri"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Üst Boşluk",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Alt Boşluk",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Ürün Özellikleri"
    }
  ]
}
{% endschema %}
